\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Functional groups of primary producers experience increased baseline probability to persist (sub-panels), and the impact of these disturbances on the persistence (y-axis) of functional groups of consumer species (group 1-6, x-axis) is presented. The first sub-panel shows the persistence without any disturbance on the basal level. The following sub-panels show the effect on groups of consumers when disturbing plant species based on their functional group \citep  {Baskervilleetal2011}. The functional response of consumers to the loss of prey species follows a non-linear curve.\relax }}{7}{figure.caption.1}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:groups_nonlinear}{{1}{7}{Functional groups of primary producers experience increased baseline probability to persist (sub-panels), and the impact of these disturbances on the persistence (y-axis) of functional groups of consumer species (group 1-6, x-axis) is presented. The first sub-panel shows the persistence without any disturbance on the basal level. The following sub-panels show the effect on groups of consumers when disturbing plant species based on their functional group \citep {Baskervilleetal2011}. The functional response of consumers to the loss of prey species follows a non-linear curve.\relax }{figure.caption.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Functional groups of primary producers experience increased baseline probability to persist (sub-panels), and the impact of these disturbances on the persistence (y-axis) of functional groups of consumer species (group 1-6, x-axis) is presented. The first sub-panel shows the persistence without any disturbance on the basal level. The following sub-panels show the effect on groups of consumers when disturbing plant species based on their functional group \citep  {Baskervilleetal2011}. The functional response of consumers to the loss of prey species follows a linear curve.\relax }}{8}{figure.caption.2}\protected@file@percent }
\newlabel{fig:groups_linear}{{2}{8}{Functional groups of primary producers experience increased baseline probability to persist (sub-panels), and the impact of these disturbances on the persistence (y-axis) of functional groups of consumer species (group 1-6, x-axis) is presented. The first sub-panel shows the persistence without any disturbance on the basal level. The following sub-panels show the effect on groups of consumers when disturbing plant species based on their functional group \citep {Baskervilleetal2011}. The functional response of consumers to the loss of prey species follows a linear curve.\relax }{figure.caption.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Impact of disturbances on the basal level based on habitats on groups of consumer species (group 1-6, x-axis). The y-axis shows the probability that the group of consumer will persist. The first sub figure shows the persistence without any disturbance on the basal level. The following sub figures show the effect on groups of consumers when disturbing plant species based on their habitat, indicated by each sub figure's label; S (shrubland), D (disturbed), T (thicket), R (riverland), G (grassland), W (wetland), K (kopje). The functional response of consumers to the loss of prey species follows a non-linear curve.\relax }}{9}{figure.caption.3}\protected@file@percent }
\newlabel{fig:habitats}{{3}{9}{Impact of disturbances on the basal level based on habitats on groups of consumer species (group 1-6, x-axis). The y-axis shows the probability that the group of consumer will persist. The first sub figure shows the persistence without any disturbance on the basal level. The following sub figures show the effect on groups of consumers when disturbing plant species based on their habitat, indicated by each sub figure's label; S (shrubland), D (disturbed), T (thicket), R (riverland), G (grassland), W (wetland), K (kopje). The functional response of consumers to the loss of prey species follows a non-linear curve.\relax }{figure.caption.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Impact of disturbances on the basal level based on traits on consumer species (group 1-6, x-axis). The y-axis shows the probability that the group of consumer will persist. The first sub figure shows the persistence without any disturbance on the basal level. The following sub figures show the effect on groups of consumers when disturbing plant species based on various traits; tree (large trees), shurb (small trees and shrubs), herbs (herbs and forbs, perennial), graminoid (grasses), annual (annual flowering plants). The functional response of consumers to the loss of prey species follows a non-linear curve.\relax }}{10}{figure.caption.4}\protected@file@percent }
\newlabel{fig:traits}{{4}{10}{Impact of disturbances on the basal level based on traits on consumer species (group 1-6, x-axis). The y-axis shows the probability that the group of consumer will persist. The first sub figure shows the persistence without any disturbance on the basal level. The following sub figures show the effect on groups of consumers when disturbing plant species based on various traits; tree (large trees), shurb (small trees and shrubs), herbs (herbs and forbs, perennial), graminoid (grasses), annual (annual flowering plants). The functional response of consumers to the loss of prey species follows a non-linear curve.\relax }{figure.caption.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Impact of disturbances on the basal level based on traits on consumer species (group 1-6, x-axis). The y-axis shows the probability that the group of consumer will persist. The first sub figure shows the persistence without any disturbance on the basal level. The following sub figures show the effect on groups of consumers when disturbing plant species based on various traits; woody (woody plants), Nwoody (non-woody plants), P (perennials), A (annuals). The functional response of consumers to the loss of prey species follows a non-linear curve.\relax }}{11}{figure.caption.5}\protected@file@percent }
\newlabel{fig:gen_charac}{{5}{11}{Impact of disturbances on the basal level based on traits on consumer species (group 1-6, x-axis). The y-axis shows the probability that the group of consumer will persist. The first sub figure shows the persistence without any disturbance on the basal level. The following sub figures show the effect on groups of consumers when disturbing plant species based on various traits; woody (woody plants), Nwoody (non-woody plants), P (perennials), A (annuals). The functional response of consumers to the loss of prey species follows a non-linear curve.\relax }{figure.caption.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Impact of disturbances on the basal level based on traits and habitats on consumer species (group 1-6, panels). The y-axis shows the probability of persistence for each consumer species. The control scenario, without any additional disturbances, is indicated in each sub-figure by the shape "x", disturbance scenarios by circles. The colors represent various disturbance scenarios, described in the legend, also showing the number (n) of plant species being disturbed in each particular scenario. The functional response of consumers to the loss of prey species follows a non-linear curve.\relax }}{12}{figure.caption.6}\protected@file@percent }
\newlabel{fig:all_disturbances}{{6}{12}{Impact of disturbances on the basal level based on traits and habitats on consumer species (group 1-6, panels). The y-axis shows the probability of persistence for each consumer species. The control scenario, without any additional disturbances, is indicated in each sub-figure by the shape "x", disturbance scenarios by circles. The colors represent various disturbance scenarios, described in the legend, also showing the number (n) of plant species being disturbed in each particular scenario. The functional response of consumers to the loss of prey species follows a non-linear curve.\relax }{figure.caption.6}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Comparison of persistences in the undisturbed, control scenario (x-axis), and the various disturbance scenarios focusing on plant species traits (y-axis). Values on the line indicate that similar persistences are reached independent of disturbances on the plant level. Values below the line show that persistences are lower in the disturbed scenario than in the control scenario. The colors show the various traits disturbed presented in the legend, as well as the number of plant species (n) disturbed in each scenario. The functional response of consumers to the loss of prey species follows a non-linear curve.\relax }}{13}{figure.caption.7}\protected@file@percent }
\newlabel{fig:comp_dist_traits}{{7}{13}{Comparison of persistences in the undisturbed, control scenario (x-axis), and the various disturbance scenarios focusing on plant species traits (y-axis). Values on the line indicate that similar persistences are reached independent of disturbances on the plant level. Values below the line show that persistences are lower in the disturbed scenario than in the control scenario. The colors show the various traits disturbed presented in the legend, as well as the number of plant species (n) disturbed in each scenario. The functional response of consumers to the loss of prey species follows a non-linear curve.\relax }{figure.caption.7}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces Comparison of persistences in the undisturbed, control scenario (x-axis), and various disturbance scenarios of habitats (y-axis). Values on the line indicate that similar persistences are reached independent of disturbances on the plant level. Values below the line indicate lower persistences in the disturbed scenario than in the control scenario. The colors show the various traits disturbed presented in the legend, as well as the number of plant species (n) disturbed in each scenario. The functional response of consumers to the loss of prey species follows a non-linear curve.\relax }}{14}{figure.caption.8}\protected@file@percent }
\newlabel{fig:comp_dist_habs}{{8}{14}{Comparison of persistences in the undisturbed, control scenario (x-axis), and various disturbance scenarios of habitats (y-axis). Values on the line indicate that similar persistences are reached independent of disturbances on the plant level. Values below the line indicate lower persistences in the disturbed scenario than in the control scenario. The colors show the various traits disturbed presented in the legend, as well as the number of plant species (n) disturbed in each scenario. The functional response of consumers to the loss of prey species follows a non-linear curve.\relax }{figure.caption.8}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces Disturbance of groups of randomly chosen plant species, corresponding to the size of the functional plant groups identified by Baskerville et al. \citep  {Baskervilleetal2011}. The first sub-panel shows the persistence without any disturbance on the basal level. The following sub-panels show disturbance of random plant groups, numbered by the original functional group, containing the same number of species. The impact of these disturbances on the persistence (y-axis) of functional groups of consumer species (group 1-6, x-axis) is presented. The functional response of consumers to the loss of prey species follows a non-linear curve.\relax }}{15}{figure.caption.9}\protected@file@percent }
\newlabel{fig:random_nonlinear}{{9}{15}{Disturbance of groups of randomly chosen plant species, corresponding to the size of the functional plant groups identified by Baskerville et al. \citep {Baskervilleetal2011}. The first sub-panel shows the persistence without any disturbance on the basal level. The following sub-panels show disturbance of random plant groups, numbered by the original functional group, containing the same number of species. The impact of these disturbances on the persistence (y-axis) of functional groups of consumer species (group 1-6, x-axis) is presented. The functional response of consumers to the loss of prey species follows a non-linear curve.\relax }{figure.caption.9}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces Disturbance of groups of randomly chosen plant species, corresponding to the size of the functional plant groups identified by Baskerville et al. \citep  {Baskervilleetal2011}. The first sub-panel shows the persistence without any disturbance on the basal level. The following sub-panels show disturbance of random plant groups, numbered by the original functional group, containing the same number of species. The impact of these disturbances on the persistence (y-axis) of functional groups of consumer species (group 1-6, x-axis) is presented. The functional response of consumers to the loss of prey species follows a linear curve.\relax }}{16}{figure.caption.10}\protected@file@percent }
\newlabel{fig:random_linear}{{10}{16}{Disturbance of groups of randomly chosen plant species, corresponding to the size of the functional plant groups identified by Baskerville et al. \citep {Baskervilleetal2011}. The first sub-panel shows the persistence without any disturbance on the basal level. The following sub-panels show disturbance of random plant groups, numbered by the original functional group, containing the same number of species. The impact of these disturbances on the persistence (y-axis) of functional groups of consumer species (group 1-6, x-axis) is presented. The functional response of consumers to the loss of prey species follows a linear curve.\relax }{figure.caption.10}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {11}{\ignorespaces Effect of disturbing a number of randomly chosen basal species, corresponding to the size of the original trophically similar groups following Baskerville et al. \citep  {Baskervilleetal2011}. The x-axis is ordered by the size of the corresponding group label, going from the smallest corresponding group number to the largest group. The y-axis shows the fraction of extreme p-values ($0.05>p>0.95$) within each groups of consumer species (panels). If persistences for \emph  {all} species included in a group of consumers are different ($0.05>p>0.95$) from what's expected by chance (random disturbance), the fraction of extreme p-values will be 1. If persistences of \emph  {no} species in a specific consumer group is similar to what's expected by chance, the fraction of extreme p-values will be 0. The displayed value is a mean over all species included in each consumer group. Therefore, the fraction can vary from 0-1.\relax }}{17}{figure.caption.11}\protected@file@percent }
\newlabel{fig:p_val}{{11}{17}{Effect of disturbing a number of randomly chosen basal species, corresponding to the size of the original trophically similar groups following Baskerville et al. \citep {Baskervilleetal2011}. The x-axis is ordered by the size of the corresponding group label, going from the smallest corresponding group number to the largest group. The y-axis shows the fraction of extreme p-values ($0.05>p>0.95$) within each groups of consumer species (panels). If persistences for \emph {all} species included in a group of consumers are different ($0.05>p>0.95$) from what's expected by chance (random disturbance), the fraction of extreme p-values will be 1. If persistences of \emph {no} species in a specific consumer group is similar to what's expected by chance, the fraction of extreme p-values will be 0. The displayed value is a mean over all species included in each consumer group. Therefore, the fraction can vary from 0-1.\relax }{figure.caption.11}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {12}{\ignorespaces Comparison between persistence of consumer species in the original Serengeti network (x-axis) and the same network collapsed into nodes (y-axis). In the original network, a mean persistence for each group of consumers is presented. Symbols represent groups of consumer species, colors represent the trait character of plant species being disturbed. Values close to the diagonal show consistent values of persistence between the two types of network. Sub-figures show a) linear functional response ($alpha=beta=1$) to the loss of prey species, b) non-linear functional response ($alpha=beta=3$) to the loss of prey species.\relax }}{18}{figure.caption.12}\protected@file@percent }
\newlabel{fig:collapsed_traits}{{12}{18}{Comparison between persistence of consumer species in the original Serengeti network (x-axis) and the same network collapsed into nodes (y-axis). In the original network, a mean persistence for each group of consumers is presented. Symbols represent groups of consumer species, colors represent the trait character of plant species being disturbed. Values close to the diagonal show consistent values of persistence between the two types of network. Sub-figures show a) linear functional response ($alpha=beta=1$) to the loss of prey species, b) non-linear functional response ($alpha=beta=3$) to the loss of prey species.\relax }{figure.caption.12}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {13}{\ignorespaces Comparison between persistence of consumer species in the original Serengeti network (x-axis) and the same network collapsed into nodes (y-axis). In the original network, a mean persistence for each group of consumers is presented. Symbols represent groups of consumer species, colors represent the trophically similar group of plant species being disturbed. Values close to the diagonal show consistent values of persistence between the two types of network. Sub-figures show a) linear functional response ($alpha=beta=1$) to the loss of prey species, b) non-linear functional response ($alpha=beta=3$) to the loss of prey species.\relax }}{18}{figure.caption.13}\protected@file@percent }
\newlabel{fig:collapsed_groups}{{13}{18}{Comparison between persistence of consumer species in the original Serengeti network (x-axis) and the same network collapsed into nodes (y-axis). In the original network, a mean persistence for each group of consumers is presented. Symbols represent groups of consumer species, colors represent the trophically similar group of plant species being disturbed. Values close to the diagonal show consistent values of persistence between the two types of network. Sub-figures show a) linear functional response ($alpha=beta=1$) to the loss of prey species, b) non-linear functional response ($alpha=beta=3$) to the loss of prey species.\relax }{figure.caption.13}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {14}{\ignorespaces Persistence (y-axis) of apex predators in different disturbance scenarios (x-axis); a higher baseline probability for only apex predators (apex), a higher baseline probability for various plant traits (see legend, traits), a higher baseline probability for various plant traits (see legend) and for apex predators (traits apex). Sub-figures show a) linear functional response ($alpha=beta=1$) to the loss of prey species, b) non-linear functional response ($alpha=beta=3$) to the loss of prey species.\relax }}{19}{figure.caption.14}\protected@file@percent }
\newlabel{fig:apex_trait}{{14}{19}{Persistence (y-axis) of apex predators in different disturbance scenarios (x-axis); a higher baseline probability for only apex predators (apex), a higher baseline probability for various plant traits (see legend, traits), a higher baseline probability for various plant traits (see legend) and for apex predators (traits apex). Sub-figures show a) linear functional response ($alpha=beta=1$) to the loss of prey species, b) non-linear functional response ($alpha=beta=3$) to the loss of prey species.\relax }{figure.caption.14}{}}
