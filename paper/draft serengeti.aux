\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Functional groups of primary producers experience sequentially increased baseline probability to persist (sub-panels), and the impact of these disturbances on the persistence (y-axis) of functional groups of consumer species (group 1-6, x-axis) is presented. The first sub-panel shows the persistence without any disturbance on the basal level. The following sub-panels show the effect on groups of consumers when disturbing plant species based on their functional group. \citep  {Baskervilleetal2011}\relax }}{6}{figure.caption.1}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:groups}{{1}{6}{Functional groups of primary producers experience sequentially increased baseline probability to persist (sub-panels), and the impact of these disturbances on the persistence (y-axis) of functional groups of consumer species (group 1-6, x-axis) is presented. The first sub-panel shows the persistence without any disturbance on the basal level. The following sub-panels show the effect on groups of consumers when disturbing plant species based on their functional group. \citep {Baskervilleetal2011}\relax }{figure.caption.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Impact of disturbances on the basal level based on habitats on groups of consumer species (group 1-6, x-axis). The y-axis shows the probability that the group of consumer will persist. The first sub figure shows the persistence without any disturbance on the basal level. The following sub figures show the effect on groups of consumers when disturbing plant species based on their habitat, indicated by each sub figure's label; S (shrubland), D (disturbed), T (thicket), R (riverland), G (grassland), W (wetland), K (kopje). \relax }}{7}{figure.caption.2}\protected@file@percent }
\newlabel{fig:habitats}{{2}{7}{Impact of disturbances on the basal level based on habitats on groups of consumer species (group 1-6, x-axis). The y-axis shows the probability that the group of consumer will persist. The first sub figure shows the persistence without any disturbance on the basal level. The following sub figures show the effect on groups of consumers when disturbing plant species based on their habitat, indicated by each sub figure's label; S (shrubland), D (disturbed), T (thicket), R (riverland), G (grassland), W (wetland), K (kopje). \relax }{figure.caption.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Impact of disturbances on the basal level based on traits on consumer species (group 1-6, x-axis). The y-axis shows the probability that the group of consumer will persist. The first sub figure shows the persistence without any disturbance on the basal level. The following sub figures show the effect on groups of consumers when disturbing plant species based on various traits; tree (large trees), shurb (small trees and shrubs), herbs (herbs and forbs, perennial), graminoid (grasses), annual (annual flowering plants).\relax }}{8}{figure.caption.3}\protected@file@percent }
\newlabel{fig:traits}{{3}{8}{Impact of disturbances on the basal level based on traits on consumer species (group 1-6, x-axis). The y-axis shows the probability that the group of consumer will persist. The first sub figure shows the persistence without any disturbance on the basal level. The following sub figures show the effect on groups of consumers when disturbing plant species based on various traits; tree (large trees), shurb (small trees and shrubs), herbs (herbs and forbs, perennial), graminoid (grasses), annual (annual flowering plants).\relax }{figure.caption.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Impact of disturbances on the basal level based on traits on consumer species (group 1-6, x-axis). The y-axis shows the probability that the group of consumer will persist. The first sub figure shows the persistence without any disturbance on the basal level. The following sub figures show the effect on groups of consumers when disturbing plant species based on various traits; woody (woody plants), Nwoody (non-woody plants), P (perennials), A (annuals).\relax }}{9}{figure.caption.4}\protected@file@percent }
\newlabel{fig:gen_charac}{{4}{9}{Impact of disturbances on the basal level based on traits on consumer species (group 1-6, x-axis). The y-axis shows the probability that the group of consumer will persist. The first sub figure shows the persistence without any disturbance on the basal level. The following sub figures show the effect on groups of consumers when disturbing plant species based on various traits; woody (woody plants), Nwoody (non-woody plants), P (perennials), A (annuals).\relax }{figure.caption.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Persistence (y-axis) of apex predators in different disturbance scenarios (x-axis); a higher baseline probability for only apex predators (apex), a higher baseline probability for various plant traits (see legend, traits), a higher baseline probability for various plant traits (see legend) and for apex predators (traits apex). Sub-figures show a) linear functional response ($alpha=beta=1$) to the loss of prey species, b) non-linear functional response ($alpha=beta=3$) to the loss of prey species.\relax }}{10}{figure.caption.5}\protected@file@percent }
\newlabel{fig:apex_trait}{{5}{10}{Persistence (y-axis) of apex predators in different disturbance scenarios (x-axis); a higher baseline probability for only apex predators (apex), a higher baseline probability for various plant traits (see legend, traits), a higher baseline probability for various plant traits (see legend) and for apex predators (traits apex). Sub-figures show a) linear functional response ($alpha=beta=1$) to the loss of prey species, b) non-linear functional response ($alpha=beta=3$) to the loss of prey species.\relax }{figure.caption.5}{}}
