\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Impact of disturbances on the basal level based on habitats on groups of consumer species (group 1-6, x-axis). The y-axis shows the probability that the group of consumer will persist. The first sub figure shows the persistence without any disturbance on the basal level. The following sub figures show the effect on groups of consumers when disturbing plant species based on their habitat, indicated by each sub figure's label; S (shrubland), D (disturbed), T (thicket), R (riverland), G (grassland), W (wetland), K (kopje). \relax }}{3}{figure.caption.1}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:habitats}{{1}{3}{Impact of disturbances on the basal level based on habitats on groups of consumer species (group 1-6, x-axis). The y-axis shows the probability that the group of consumer will persist. The first sub figure shows the persistence without any disturbance on the basal level. The following sub figures show the effect on groups of consumers when disturbing plant species based on their habitat, indicated by each sub figure's label; S (shrubland), D (disturbed), T (thicket), R (riverland), G (grassland), W (wetland), K (kopje). \relax }{figure.caption.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Impact of disturbances on the basal level based on functional groups of consumer species (group 1-6, x-axis). The y-axis shows the probability that the group of consumer will persist. The first sub figure shows the persistence without any disturbance on the basal level. The following sub figures show the effect on groups of consumers when disturbing plant species based on their functional group \citep  {baskerville2011spatial}.\relax }}{4}{figure.caption.2}\protected@file@percent }
\newlabel{fig:groups}{{2}{4}{Impact of disturbances on the basal level based on functional groups of consumer species (group 1-6, x-axis). The y-axis shows the probability that the group of consumer will persist. The first sub figure shows the persistence without any disturbance on the basal level. The following sub figures show the effect on groups of consumers when disturbing plant species based on their functional group \citep {baskerville2011spatial}.\relax }{figure.caption.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Impact of disturbances on the basal level based on traits on consumer species (group 1-6, x-axis). The y-axis shows the probability that the group of consumer will persist. The first sub figure shows the persistence without any disturbance on the basal level. The following sub figures show the effect on groups of consumers when disturbing plant species based on various traits; tree (large trees), shurb (small trees and shrubs), herbs (herbs and forbs, perennial), graminoid (grasses), annual (annual flowering plants).\relax }}{5}{figure.caption.3}\protected@file@percent }
\newlabel{fig:traits}{{3}{5}{Impact of disturbances on the basal level based on traits on consumer species (group 1-6, x-axis). The y-axis shows the probability that the group of consumer will persist. The first sub figure shows the persistence without any disturbance on the basal level. The following sub figures show the effect on groups of consumers when disturbing plant species based on various traits; tree (large trees), shurb (small trees and shrubs), herbs (herbs and forbs, perennial), graminoid (grasses), annual (annual flowering plants).\relax }{figure.caption.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Impact of disturbances on the basal level based on traits on consumer species (group 1-6, x-axis). The y-axis shows the probability that the group of consumer will persist. The first sub figure shows the persistence without any disturbance on the basal level. The following sub figures show the effect on groups of consumers when disturbing plant species based on various traits; woody (woody plants), Nwoody (non-woody plants), P (perennials), A (annuals).\relax }}{6}{figure.caption.4}\protected@file@percent }
\newlabel{fig:gen_charac}{{4}{6}{Impact of disturbances on the basal level based on traits on consumer species (group 1-6, x-axis). The y-axis shows the probability that the group of consumer will persist. The first sub figure shows the persistence without any disturbance on the basal level. The following sub figures show the effect on groups of consumers when disturbing plant species based on various traits; woody (woody plants), Nwoody (non-woody plants), P (perennials), A (annuals).\relax }{figure.caption.4}{}}
